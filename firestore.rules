rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidMediaCategory(val) {
      return val in ['MOVIE', 'WEB_SERIES', 'ANIME', 'K_DRAMA'];
    }

    function isValidWatchStatus(val) {
      return val in ['COMPLETED', 'WATCHING', 'PLAN_TO_WATCH', 'ON_HOLD', 'DROPPED'];
    }

    function isValidPriority(val) {
      return val in ['HIGH', 'MEDIUM', 'LOW'];
    }

    function isValidAccentKey(val) {
      return val in ['AFTERGLOW_PURPLE', 'MIDNIGHT_ROSE', 'CELESTIAL_INDIGO', 'NEON_AMETHYST'];
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.bio is string && data.bio.size() <= 250 &&
        data.accentColorKey is string && isValidAccentKey(data.accentColorKey) &&
        data.compactMode is bool &&
        data.yearlyMovieGoal is int && data.yearlyMovieGoal >= 1 && data.yearlyMovieGoal <= 2000 &&
        data.yearlySeriesGoal is int && data.yearlySeriesGoal >= 1 && data.yearlySeriesGoal <= 500 &&
        data.yearlyEpisodeGoal is int && data.yearlyEpisodeGoal >= 1 && data.yearlyEpisodeGoal <= 20000 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMediaItem(data, userId) {
      return data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.mediaCategory is string && isValidMediaCategory(data.mediaCategory) &&
        data.posterUrl is string && data.posterUrl.size() <= 1000 &&
        data.genre is string && data.genre.size() <= 160 &&
        data.language is string && data.language.size() <= 60 &&
        data.releaseYear is int && data.releaseYear >= 1880 && data.releaseYear <= 2040 &&
        data.streamingPlatform is string && data.streamingPlatform.size() <= 80 &&
        data.imdbRating is number && data.imdbRating >= 0 && data.imdbRating <= 10 &&
        data.personalRating is number && data.personalRating >= 0 && data.personalRating <= 10 &&
        data.runtimeMinutes is int && data.runtimeMinutes >= 0 && data.runtimeMinutes <= 2000 &&
        data.director is string && data.director.size() <= 160 &&
        data.mainCast is string && data.mainCast.size() <= 400 &&
        data.country is string && data.country.size() <= 80 &&
        data.watchStatus is string && isValidWatchStatus(data.watchStatus) &&
        data.startDate is string && data.startDate.size() <= 20 &&
        data.completionDate is string && data.completionDate.size() <= 20 &&
        data.rewatchCount is int && data.rewatchCount >= 0 && data.rewatchCount <= 500 &&
        data.rewatchFlag is bool &&
        data.trailerLink is string && data.trailerLink.size() <= 500 &&
        data.imdbLink is string && data.imdbLink.size() <= 500 &&
        data.personalReview is string && data.personalReview.size() <= 3000 &&
        data.notes is string && data.notes.size() <= 2000 &&
        data.totalSeasons is int && data.totalSeasons >= 0 && data.totalSeasons <= 200 &&
        data.currentSeason is int && data.currentSeason >= 0 && data.currentSeason <= 200 &&
        data.totalEpisodes is int && data.totalEpisodes >= 0 && data.totalEpisodes <= 10000 &&
        data.episodesWatched is int && data.episodesWatched >= 0 && data.episodesWatched <= 10000 &&
        data.currentEpisode is int && data.currentEpisode >= 0 && data.currentEpisode <= 10000 &&
        data.watchlistItem is bool &&
        data.priority is string && isValidPriority(data.priority) &&
        data.dateAdded is string && data.dateAdded.size() <= 20 &&
        data.favourite is bool &&
        data.allTimeFavourite is bool &&
        data.manualRank is int && data.manualRank >= 0 && data.manualRank <= 500 &&
        data.hiddenGem is bool &&
        data.moodTags is list && data.moodTags.size() <= 6 &&
        (data.moodTags.size() == 0 || data.moodTags[0] is string) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidQuoteItem(data, userId) {
      return data.userId == userId &&
        data.quoteText is string && data.quoteText.size() >= 1 && data.quoteText.size() <= 600 &&
        data.sourceTitle is string && data.sourceTitle.size() >= 1 && data.sourceTitle.size() <= 160 &&
        data.characterName is string && data.characterName.size() <= 120 &&
        data.mediaItemId is string && data.mediaItemId.size() <= 128 &&
        data.mediaCategory is string && isValidMediaCategory(data.mediaCategory) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().keys().hasAll([
          'userId', 'displayName', 'bio', 'accentColorKey', 'compactMode',
          'yearlyMovieGoal', 'yearlySeriesGoal', 'yearlyEpisodeGoal', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'displayName', 'bio', 'accentColorKey', 'compactMode',
          'yearlyMovieGoal', 'yearlySeriesGoal', 'yearlyEpisodeGoal', 'createdAt', 'updatedAt'
        ]) &&
        isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'bio', 'accentColorKey', 'compactMode',
          'yearlyMovieGoal', 'yearlySeriesGoal', 'yearlyEpisodeGoal', 'updatedAt'
        ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /media_items/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(itemId) &&
          incoming().keys().hasAll([
            'userId', 'title', 'mediaCategory', 'posterUrl', 'genre', 'language',
            'releaseYear', 'streamingPlatform', 'imdbRating', 'personalRating',
            'runtimeMinutes', 'director', 'mainCast', 'country', 'watchStatus',
            'startDate', 'completionDate', 'rewatchCount', 'rewatchFlag',
            'trailerLink', 'imdbLink', 'personalReview', 'notes',
            'totalSeasons', 'currentSeason', 'totalEpisodes', 'episodesWatched',
            'currentEpisode', 'watchlistItem', 'priority', 'dateAdded',
            'favourite', 'allTimeFavourite', 'manualRank', 'hiddenGem',
            'moodTags', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'title', 'mediaCategory', 'posterUrl', 'genre', 'language',
            'releaseYear', 'streamingPlatform', 'imdbRating', 'personalRating',
            'runtimeMinutes', 'director', 'mainCast', 'country', 'watchStatus',
            'startDate', 'completionDate', 'rewatchCount', 'rewatchFlag',
            'trailerLink', 'imdbLink', 'personalReview', 'notes',
            'totalSeasons', 'currentSeason', 'totalEpisodes', 'episodesWatched',
            'currentEpisode', 'watchlistItem', 'priority', 'dateAdded',
            'favourite', 'allTimeFavourite', 'manualRank', 'hiddenGem',
            'moodTags', 'createdAt', 'updatedAt'
          ]) &&
          isValidMediaItem(incoming(), userId);

        allow update: if isOwner(userId) &&
          isValidId(itemId) &&
          isValidMediaItem(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'mediaCategory', 'posterUrl', 'genre', 'language',
            'releaseYear', 'streamingPlatform', 'imdbRating', 'personalRating',
            'runtimeMinutes', 'director', 'mainCast', 'country', 'watchStatus',
            'startDate', 'completionDate', 'rewatchCount', 'rewatchFlag',
            'trailerLink', 'imdbLink', 'personalReview', 'notes',
            'totalSeasons', 'currentSeason', 'totalEpisodes', 'episodesWatched',
            'currentEpisode', 'watchlistItem', 'priority', 'dateAdded',
            'favourite', 'allTimeFavourite', 'manualRank', 'hiddenGem',
            'moodTags', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      match /quotes/{quoteId} {
        allow get: if isOwner(userId) && isValidId(quoteId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(quoteId) &&
          incoming().keys().hasAll([
            'userId', 'quoteText', 'sourceTitle', 'characterName',
            'mediaItemId', 'mediaCategory', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'quoteText', 'sourceTitle', 'characterName',
            'mediaItemId', 'mediaCategory', 'createdAt', 'updatedAt'
          ]) &&
          isValidQuoteItem(incoming(), userId);

        allow update: if isOwner(userId) &&
          isValidId(quoteId) &&
          isValidQuoteItem(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'quoteText', 'sourceTitle', 'characterName',
            'mediaItemId', 'mediaCategory', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(quoteId);
      }
    }
  }
}
